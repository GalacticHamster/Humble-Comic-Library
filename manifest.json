{
  "manifest_version": 3,
  "name": "Humble Comic Library",
  "version": "0.1.0",
  "description": "Locally mark Humble Bundle books, comics, games, and software you already own.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Humble Comic Library",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.humblebundle.com/books*",
        "https://www.humblebundle.com/games*",
        "https://www.humblebundle.com/software*",
        "https://www.humblebundle.com/bundles*",
        "https://www.humblebundle.com/home/purchases*"
      ],
      "js": [
        "theme.js",
        "shared.js",
        "collection-mappings.js",
        "ownership.js",
        "content.js"
      ],
      "css": [
        "theme.css",
        "content.css",
        "theme-overlays.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
